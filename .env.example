# Copy this file to ".env" and fill in values. NEVER commit ".env".
# Milestone 1 does not read real credentials; only the approval signing key is used.

# Secret used to sign approvals. Use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
OUTREACH_APPROVAL_KEY=change-me-to-a-long-random-string

